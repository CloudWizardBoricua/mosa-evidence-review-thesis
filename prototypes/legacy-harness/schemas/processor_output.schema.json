{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mosa/processor-output-1.0.schema.json",
  "title": "MOSA Processor Output 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "classification",
    "confidence",
    "risk_score",
    "processor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "nominal",
        "watch",
        "alert"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "processor_id": {
      "type": "string",
      "minLength": 1
    }
  }
}